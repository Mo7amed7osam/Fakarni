# Server-only parsing gateway env. Do not put these in the mobile app env.
PARSE_GATEWAY_PORT=8787
PARSE_GATEWAY_HOST=0.0.0.0
PARSE_GATEWAY_BASE_URL=https://api.your-llm-provider.com/v1
PARSE_GATEWAY_API_KEY=your_server_side_provider_key
PARSE_GATEWAY_MINI_MODEL=your_mini_model
PARSE_GATEWAY_STRONG_MODEL=your_strong_model
